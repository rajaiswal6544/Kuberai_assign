# Copy to .env. DATABASE_URL is set by docker-compose.yml.

# LLM (Phase 5). LLM_PROVIDER: groq | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=8

# Price source (Phase 3). PRICE_BASE is INR per gram, ex-GST. PRICE_SOURCE_MODE: up | down
PRICE_BASE=15131.23
PRICE_SOURCE_MODE=up
PRICE_MAX_AGE_SECONDS=300
QUOTE_TTL_SECONDS=300
PENDING_ACTION_TTL_SECONDS=300

# Calendar dates for SIPs
BUSINESS_TZ=Asia/Kolkata

# Admin (/admin/*) needs this X-Admin-Token value. Shared-secret stopgap, not real auth.
ADMIN_TOKEN=dev-admin-token
# development | test | production (production disables /admin/clock and /admin/reset)
ENV=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.jsonl
